# ─── 共享环境变量（B5 单源）───
# 根 .env.shared 提供跨 app 的默认值；各 app 的 .env / .env.development / .env.production 可覆盖。
# 由 @art/app-config 的 createBaseConfig 加载（app env 优先级高于此文件）。

# API 请求基础路径（开发环境指向代理）
VITE_API_URL = /

# 目标接口地址（本地开发通过 Vite 代理转发；解决跨域）
VITE_API_PROXY_URL = https://m1.apifoxmock.com/m1/6400575-6097373-default

# 请求时是否携带 Cookie
VITE_WITH_CREDENTIALS = false
