# ── 通用配置 ──
# 注：原 VITE_VERSION 已迁移至仓库根 VERSION 文件（构建期由 @art/app-config 注入 __APP_VERSION__）

# 应用编码（B2 契约：appCode 注入 /user/info 与 /system/menus）
VITE_APP_CODE = app_article

# 端口号
VITE_PORT = 3108

# 应用部署基础路径（如部署到子目录 /admin，则配置为 /admin/）
VITE_BASE_URL = /

# 权限模式：frontend 前端模式 / backend 后端模式
VITE_ACCESS_MODE = frontend

# 请求是否携带 Cookie
VITE_WITH_CREDENTIALS = false

# 是否输出路由信息
VITE_OPEN_ROUTE_INFO = false

# 锁屏解锁密钥
VITE_LOCK_ENCRYPT_KEY = s3cur3k3y4adpro
