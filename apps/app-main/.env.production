# ── 生产环境配置 ──

# 应用部署基础路径（如部署到子目录 /admin，则配置为 /admin/）
VITE_BASE_URL = /

# 子应用（app-system）生产环境 manifest 地址；留空时使用内置线上默认值
VITE_REMOTE_APP_SYSTEM_URL = https://app-system.qxiangkj.cn/mf-manifest.json

# API 地址前缀
VITE_API_URL = https://m1.apifoxmock.com/m1/6400575-6097373-default

# 是否在构建时移除 console
VITE_DROP_CONSOLE = true
