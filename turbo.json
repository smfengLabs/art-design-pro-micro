{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["VERSION", "tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "typecheck"],
      "outputs": ["dist/**"],
      "env": [
        "VITE_APP_CODE",
        "VITE_API_URL",
        "VITE_API_PROXY_URL",
        "VITE_BASE_URL",
        "VITE_ACCESS_MODE",
        "VITE_WITH_CREDENTIALS",
        "VITE_DROP_CONSOLE",
        "VITE_OPEN_ROUTE_INFO",
        "VITE_LOCK_ENCRYPT_KEY",
        "VITE_PORT"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": true
    },
    "depcruise": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
