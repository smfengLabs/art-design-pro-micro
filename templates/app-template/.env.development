# ── 开发环境配置 ──

# 应用部署基础路径（如部署到子目录 /admin，则配置为 /admin/）
VITE_BASE_URL = /

# API 请求基础路径（开发环境配置为 / 使用代理；生产环境配置为后端地址）
VITE_API_URL = /

# 代理目标地址（开发跨域通过 Vite 代理转发请求到此地址）
VITE_API_PROXY_URL = https://m1.apifoxmock.com/m1/6400575-6097373-default

# 是否在构建时移除 console
VITE_DROP_CONSOLE = false

# 多端数据同步 WebSocket 端点（可选）
# 未配置时：生产构建按同源 /ws 推导；本地开发跳过连接（不产生失败日志）
# VITE_WS_URL = wss://api.example.com/ws
