# ── 生产环境配置 ──

# 应用部署基础路径（如部署到子目录 /admin，则配置为 /admin/）
VITE_BASE_URL = /

# 子应用对外访问的绝对 publicPath（MF manifest/remoteEntry 跨域加载使用）
VITE_REMOTE_PUBLIC_PATH = https://app-template.qxiangkj.cn/

# API 地址前缀
VITE_API_URL = https://m1.apifoxmock.com/m1/6400575-6097373-default

# 是否在构建时移除 console
VITE_DROP_CONSOLE = true
