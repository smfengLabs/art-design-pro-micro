{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "paths": {
      "@/*": ["templates/app-template/src/*"],
      "@imgs/*": ["templates/app-template/src/assets/images/*"],
      "@art/app-utils": ["packages/app-utils/src/index.ts"],
      "@art/app-api": ["packages/app-api/src/index.ts"],
      "@art/app-core": ["packages/app-core/src/index.ts"],
      "@art/app-core/bootstrap": ["packages/app-core/src/bootstrap.ts"],
      "@art/app-components": ["packages/app-components/src/index.ts"],
      "@art/app-components/layouts": ["packages/app-components/src/layouts/index.ts"],
      "@art/app-base": ["packages/app-base/src/index.ts"],
      "@art/app-config": ["packages/app-config/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue", "vite.config.ts"]
}
